            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Falla en cableado de red de oficina\",\n  \"description\": \"El equipo no detecta conexión de red cableada en el puesto 14\",\n  \"category\": \"RED\",\n  \"priority\": \"ALTA\",\n  \"site\": \"Sede Central\",\n  \"affectedAsset\": \"Switch-Piso2-Sw01\"\n}"
